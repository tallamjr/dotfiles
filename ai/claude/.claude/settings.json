{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "feedbackSurveyState": {
    "lastShownTime": 1754079108753
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-code-docs/claude-docs-helper.sh hook-check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude-code-project-index/scripts/run_python.sh /Users/tallam/.claude-code-project-index/scripts/update_index.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/ai/claude/.claude/hooks/todo-tracker.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude-code-project-index/scripts/run_python.sh /Users/tallam/.claude-code-project-index/scripts/reindex_if_needed.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/dotfiles/ai/claude/.claude/hooks/auto-verify.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "WebFetch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(uv sync)",
      "Bash(uv run mkdocs serve)",
      "Bash(uv run mkdocs build)",
      "Bash(uv run pytest)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(pre-commit *)",
      "Bash(~/.claude-code-docs/claude-docs-helper.sh *)",
      "Edit(src/**)",
      "Edit(*.md)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(docker *)",
      "Edit(package.json)",
      "Edit(requirements.txt)",
      "Edit(.env*)"
    ],
    "deny": [
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "default"
  }
}
