{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "75000"
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git diff)",
      "Bash(git status)",
      "Bash(pre-commit:*)",
      "Bash(uv run mkdocs build)",
      "Bash(uv run mkdocs serve)",
      "Bash(uv run pytest)",
      "Bash(uv sync)",
      "Bash(~/.claude-code-docs/claude-docs-helper.sh:*)",
      "Edit(*.md)",
      "Edit(src/**)",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "WebFetch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "Bash(python3:*)",
      "Bash(ruby -e:*)"
    ],
    "deny": [
      "Bash(git rebase:*)",
      "Bash(git rebase)",
      "Bash(git reset --hard:*)",
      "Bash(git reset:*)",
      "Bash(git reset)",
      "Bash(git restore:*)",
      "Bash(git restore)",
      "Bash(git push --force)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git commit:*)",
      "Bash(git commit)",
      "Bash(docker:*)",
      "Bash(sudo:*)",
      "Edit(package.json)",
      "Edit(requirements.txt)",
      "Edit(.env*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-code-docs/claude-docs-helper.sh hook-check"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-error-suppression.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-venv-python.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude-code-project-index/scripts/run_python.sh /Users/tallam/.claude-code-project-index/scripts/update_index.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Check if the file that was just edited contains ASCII box-drawing characters (lines with characters like U+2500 range: ┌ ┐ └ ┘ │ ─ ├ ┤). If it does NOT contain any box-drawing characters, respond with just 'No box-drawing diagrams found - no check needed.' and nothing else. If it DOES contain box-drawing diagrams, verify alignment: for each box, count the inner width from the top border (number of ─ between ┌ and ┐), then check that every content line between │...│ has exactly that many display columns of content (multi-byte UTF-8 chars like x ← → ↓ count as 1 display column). If any boxes are misaligned, report which lines need fixing. If all boxes are aligned, respond with 'All box-drawing diagrams verified - alignment correct.' Context: $ARGUMENTS",
            "if": "Edit(*.md)|Write(*.md)|Edit(*.txt)|Write(*.txt)",
            "statusMessage": "Checking ASCII art alignment..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude-code-project-index/scripts/run_python.sh /Users/tallam/.claude-code-project-index/scripts/reindex_if_needed.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "outputStyle": "explanatory",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754079108753
  }
}
