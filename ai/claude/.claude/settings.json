{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "feedbackSurveyState": {
    "lastShownTime": 1754079108753
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-code-docs/claude-docs-helper.sh hook-check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude-code-project-index/scripts/run_python.sh /Users/tallam/.claude-code-project-index/scripts/update_index.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/ai/claude/.claude/hooks/todo-tracker.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude/hooks/target/release/api-fallback",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tallam/.claude-code-project-index/scripts/run_python.sh /Users/tallam/.claude-code-project-index/scripts/reindex_if_needed.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "75000"
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git diff)",
      "Bash(git status)",
      "Bash(pre-commit:*)",
      "Bash(uv run mkdocs build)",
      "Bash(uv run mkdocs serve)",
      "Bash(uv run pytest)",
      "Bash(uv sync)",
      "Bash(~/.claude-code-docs/claude-docs-helper.sh:*)",
      "Edit(*.md)",
      "Edit(src/**)",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "WebFetch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git commit:*)",
      "Bash(git commit)",
      "Bash(docker:*)",
      "Bash(sudo:*)",
      "Edit(package.json)",
      "Edit(requirements.txt)",
      "Edit(.env*)"
    ],
    "deny": [
      "Bash(git rebase:*)",
      "Bash(git rebase)",
      "Bash(git reset --hard:*)",
      "Bash(git reset:*)",
      "Bash(git reset)",
      "Bash(git push --force)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "default"
  }
}
