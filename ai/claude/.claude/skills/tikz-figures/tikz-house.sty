\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikz-house}[2026/10/16 House style for TikZ figures (LuaLaTeX)]

% Fonts: Tahoma text, Menlo code. Maths stays Computer Modern.
\RequirePackage{fontspec}
\IfFontExistsTF{Tahoma}{\setsansfont{Tahoma}[Scale=0.92]}{}
\IfFontExistsTF{Menlo}{\setmonofont{Menlo}[Scale=MatchLowercase]}{}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{amsmath}

\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta, calc, positioning, fit, backgrounds,
  shapes.geometric, decorations.pathmorphing, decorations.pathreplacing, decorations.markings,
  shadings, 3d, angles, quotes, patterns}

% Palette sampled from the EE259 slides.
\definecolor{hsText}{HTML}{1D262A}
\definecolor{hsFill}{HTML}{F5FBFF}
\definecolor{hsStroke}{HTML}{4B82B1}
\definecolor{hsArrow}{HTML}{254D71}
\definecolor{hsGrid}{HTML}{D2E1EF}
\definecolor{hsRed}{HTML}{FC1721}
\definecolor{hsLens}{HTML}{52BDFC}
% Data series, in order of use.
\definecolor{hsData1}{HTML}{1F77B4}
\definecolor{hsData2}{HTML}{FF7F0E}
\definecolor{hsData3}{HTML}{2CA02C}
\definecolor{hsData4}{HTML}{D62728}
\definecolor{hsData5}{HTML}{9467BD}

\tikzset{
  every picture/.append style={text=hsText, font=\small, >={Stealth[length=4pt,width=3pt]}},
  every node/.append style={align=center},
  % Boxes and arrows.
  block/.style={draw=hsStroke, fill=hsFill, line width=0.8pt, rounded corners=3pt,
    align=center, inner sep=4pt, minimum height=15mm, minimum width=14mm},
  signal/.style={draw=hsArrow, line width=0.8pt, -{Stealth[length=4pt,width=3pt]}},
  axis arrow/.style={draw=hsText!70, line width=0.8pt, -{Stealth[length=4pt,width=3pt]}},
  % Single-headed thin arrow for short radius marks.
  radius arrow/.style={draw=hsText, line width=0.4pt, -{Stealth[length=2.5pt,width=2pt]}},
  % Annotation.
  dim/.style={draw=hsText, line width=0.4pt,
    {Stealth[length=3pt,width=2.5pt]}-{Stealth[length=3pt,width=2.5pt]}},
  guide/.style={draw=hsText!60, line width=0.4pt, dotted},
  % Optics.
  beam edge/.style={draw=hsRed, line width=0.9pt, densely dashed},
  lens/.style={draw=hsLens!70!hsArrow, line width=0.6pt,
    left color=white, right color=hsLens},
  source/.style={fill=black, text=white, rounded corners=2pt, font=\small\bfseries,
    inner sep=3pt, minimum height=6mm},
  % Mechanics: springs, dampers, walls. Helpers below take start, angle, length.
  mech/.style={draw=hsArrow, line width=0.8pt},
  spring/.style={mech, decorate, decoration={zigzag, segment length=3mm,
    amplitude=2mm, pre length=5mm, post length=5mm}},
  node dot/.style={circle, fill=hsText, inner sep=0pt, minimum size=3pt},
}

% Lines-only build for the placement check: text keeps its space but is invisible.
\ifdefined\hsLinesOnly
  \tikzset{every node/.append style={text opacity=0}}
\fi

% Plot style. Use with \begin{axis}[house axis].
\pgfplotsset{
  house axis/.style={
    width=0.9\linewidth, height=0.55\linewidth,
    axis line style={hsText!70, line width=0.5pt},
    tick style={hsText!70, line width=0.5pt},
    tick label style={font=\footnotesize},
    label style={font=\small},
    legend style={font=\footnotesize, draw=none, fill=none, row sep=-1pt},
    grid=major, major grid style={hsGrid, line width=0.3pt},
    every axis plot/.append style={line width=1pt},
    cycle list={
      {color=hsData1}, {color=hsData2}, {color=hsData3}, {color=hsData4}, {color=hsData5}},
  },
}

% Gaussian beam radius at distance z from the waist (all in cm).
% Usage inside a plot: ({\x},{\gaussradius{\x}{waist}{rayleigh}})
\newcommand{\gaussradius}[3]{(#2*sqrt(1+((#1)/(#3))^2))}

% Biconvex thin lens. #1 centre, #2 half-height as a plain number in cm.
\newcommand{\thinlens}[2]{%
  \begin{scope}[shift={#1}]
    \path[lens] (0,#2) .. controls ({0.38*#2},{0.45*#2}) and ({0.38*#2},{-0.45*#2}) .. (0,-#2)
      .. controls ({-0.38*#2},{-0.45*#2}) and ({-0.38*#2},{0.45*#2}) .. (0,#2);
  \end{scope}}

% Mechanical parts. #1 start point, #2 angle in degrees, #3 length in cm.
\newcommand{\spring}[3]{%
  \begin{scope}[shift={#1}, rotate=#2]\draw[spring] (0,0) -- (#3,0);\end{scope}}
\newcommand{\damper}[3]{%
  \begin{scope}[shift={#1}, rotate=#2]
    \draw[mech] (0,0) -- ({0.35*#3},0);
    \draw[mech] ({0.7*#3},0.25) -- ({0.35*#3},0.25) -- ({0.35*#3},-0.25) -- ({0.7*#3},-0.25);
    \draw[mech] ({0.5*#3},0) -- (#3,0);
    \draw[mech, line width=1.4pt] ({0.5*#3},0.15) -- ({0.5*#3},-0.15);
  \end{scope}}
% Hatched wall on the left of the line from #1 along angle #2, length #3.
\newcommand{\hatchedwall}[3]{%
  \begin{scope}[shift={#1}, rotate=#2]
    \fill[pattern=north east lines, pattern color=hsStroke] (-0.3,0) rectangle (0,#3);
    \draw[hsStroke, line width=1.2pt] (0,0) -- (0,#3);
  \end{scope}}
